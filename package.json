{
  "name": "la-fnb",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/api.test.js",
    "test:ui": "node tests/browser.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/*.js\" \"tests/*.{js,mjs}\" \"scripts/*.mjs\" vite.config.js",
    "test:zoom": "node tests/zoom.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "prettier": "^3.10.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
